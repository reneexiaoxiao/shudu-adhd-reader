{
  "manifest_version": 3,
  "name": "舒读 · ADHD 网页阅读器",
  "version": "0.4.5",
  "description": "优化公众号、AI 内参、即刻、X/Twitter 与普通文章页，并提供 ADHD 友好的分级智能译读。",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://mp.weixin.qq.com/*",
    "https://m.okjike.com/*",
    "https://web.okjike.com/*",
    "https://okjike.com/*",
    "https://x.com/*",
    "https://twitter.com/*",
    "https://ai.candobear.com/*",
    "https://open.bigmodel.cn/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "舒读",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mp.weixin.qq.com/*",
        "https://m.okjike.com/*",
        "https://web.okjike.com/*",
        "https://okjike.com/*",
        "https://x.com/*",
        "https://twitter.com/*",
        "https://ai.candobear.com/*"
      ],
      "css": ["reader.css", "translation.css"],
      "js": ["translation-core.js", "content.js", "translation.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-translation": {
      "suggested_key": {
        "default": "Alt+Shift+F",
        "mac": "Alt+Shift+F"
      },
      "description": "开启或暂停滚动译读"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["fonts/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
